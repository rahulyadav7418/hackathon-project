<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
    <link rel="stylesheet" href="/style.css"/>
</head>
<body>
    <h1>Edit Offer</h1>
    <form action="/offers/<%= offer._id %>?_method=PUT" method="POST">
        <input type="text" name="title" value="<%= offer.title %>">
        <input type="text" name="description" value="<%= offer.description %>">
        <input type="number" name="originalPrice" value="<%= offer.originalPrice %>">
        <input type="number" name="offerPrice" value="<%= offer.offerPrice %>">
        <input type="number" name="capacity" value="<%= offer.capacity %>">
        <button class="updateBtn">Update</button>
    </form>
    
</body>
</html>